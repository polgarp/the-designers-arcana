---
import Layout from '../components/Layout.astro';
import WindowChrome from '../components/WindowChrome.astro';
import FilterRail from '../components/FilterRail.astro';
import CardTile from '../components/CardTile.astro';
import ProgressStrip from '../components/ProgressStrip.astro';
import { majors, minorsBySuit, suitOrder, progress, type Card } from '../lib/cards';
import { SITE, SUITS } from '../config';
import { withBase } from '../lib/url';

const sections: { title: string; sub: string; cards: Card[] }[] = [
  { title: 'Major Arcana', sub: 'The career, as an arc — 0 to XXI.', cards: majors },
  ...suitOrder.map((s) => ({
    title: SUITS[s].label,
    sub: SUITS[s].domain,
    cards: minorsBySuit[s],
  })),
];
---

<Layout title={`${SITE.name} · ${SITE.tagline}`}>
  <main class="shell">
    <WindowChrome>
      <header class="masthead">
        <h1 class="masthead__lead t-italic">A tarot for people who ship.</h1>
        <p class="masthead__sub t-name">
          Seventy-eight cards for the parts of being a product designer no one
          warns you about.
        </p>
        <p class="masthead__status label">
          Illustrated one plate at a time —
          <span class="masthead__count">
            <strong>{progress.all.ready} of {progress.all.total}</strong> revealed
          </span>
        </p>
      </header>

      <div class="gallery">
        <FilterRail />

        <div class="gallery__main">
          {sections.map((sec) => (
            <section class="deck-section" data-section>
              <header class="section-head">
                <h2 class="section-head__title t-name">{sec.title}</h2>
                <span class="section-head__sub label">{sec.sub}</span>
                <span class="section-head__rule" aria-hidden="true"></span>
                <span class="section-head__count label">{sec.cards.length}</span>
              </header>
              <div class="grid">
                {sec.cards.map((c) => (
                  <CardTile
                    variant="gallery"
                    name={c.name}
                    suit={c.suit}
                    ready={c.ready}
                    artHref={c.artThumb ?? c.artHref}
                    backHref={c.backThumb ?? c.backHref}
                    href={withBase(`cards/${c.id}/`)}
                    transitionName={`card-${c.id}`}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

      <ProgressStrip />
    </WindowChrome>
  </main>
</Layout>

<style>
  /* The framing the page used to keep on the About page only: what this is,
     and why most of it is face-down. Same voice and measure as About's lead,
     so the two pages rhyme. */
  .masthead {
    margin: 0 0 clamp(1.3rem, 4.5vw, 3rem);
  }
  .masthead__lead {
    margin: 0;
    font-size: clamp(1.5rem, 3.6vw, 2.1rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    max-width: 30ch;
    text-wrap: balance;
  }
  .masthead__sub {
    margin: 0.7rem 0 0;
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--ink-60);
    max-width: 46ch;
  }
  .masthead__status {
    margin: 1.1rem 0 0;
    font-size: var(--fs-xs);
  }
  /* keep "2 of 78 revealed" whole — the count breaking across lines reads
     as two unrelated numbers */
  .masthead__count { white-space: nowrap; }
  .masthead__status strong { color: var(--house); font-weight: inherit; }

  .gallery {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: clamp(1.2rem, 3vw, 2.6rem);
    align-items: start;
  }
  .gallery__main { display: flex; flex-direction: column; gap: 2.6rem; min-width: 0; }

  .section-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-bottom: 1.1rem;
  }
  .section-head__title { font-size: 1.15rem; line-height: 1; color: var(--ink); }
  .section-head__sub { grid-row: 2; grid-column: 1 / -1; color: var(--ink-60); }
  .section-head__rule {
    height: 1px;
    background: var(--ink-30);
  }
  .section-head__count { line-height: 1; color: var(--ink-60); }

  /* 126px, not the 132px the tiles actually render at: at 1440 the main
     column is 895.4px and six 132px tracks plus five 20.8px gaps need 896 —
     short by half a pixel, so auto-fill dropped to five columns and stretched
     every tile. The lower floor buys the sixth column back; seven still can't
     fit, so tiles land at ~132px anyway. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(126px, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.3rem);
  }

  @media (max-width: 680px) {
    .gallery { grid-template-columns: 1fr; gap: 1.4rem; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); }
  }
</style>
